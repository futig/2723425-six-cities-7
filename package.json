{
  "name": "six-cities",
  "version": "4.0.0",
  "description": "Проект «Шесть городов» от HTML Academy",
  "keywords": [
    "rest",
    "api",
    "node.js"
  ],
  "main": "main.js",
  "scripts": {
    "start": "npm run build && node ./dist/main.rest.js",
    "start:dev": "npm run ts ./src/main.rest.ts | pino-pretty --colorize --translateTime SYS:standard",
    "cli": "npm run build && node ./dist/main.cli.js",
    "build": "npm run clean && npm run compile",
    "lint": "eslint src/ --ext .ts",
    "compile": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "ts": "node --no-warnings=ExperimentalWarning --loader ts-node/esm",
    "mock:server": "json-server ./mocks/mock-server-data.json --port 3123"
  },
  "devDependencies": {
    "@types/convict": "6.1.6",
    "@types/convict-format-with-validator": "6.0.6",
    "@types/node": "24.19.1",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "8.57.1",
    "eslint-config-htmlacademy": "9.1.1",
    "json-server": "0.17.4",
    "pino-pretty": "13.2.0",
    "rimraf": "3.0.2",
    "ts-node": "10.9.1",
    "tslib": "2.8.1",
    "typescript": "6.0.3"
  },
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=8"
  },
  "dependencies": {
    "chalk": "6.0.1",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "dotenv": "18.0.7",
    "inversify": "8.2.3",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2"
  }
}
